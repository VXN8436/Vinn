            "dev.chunkindicators.ChunkIndicatorsMod"
        ]
    },
    "depends": {
        "fabricloader": ">=0.19.2",
        "minecraft": "~26.1.2",
        "java": ">=25",
        "fabric-api": "*"
    }
}
